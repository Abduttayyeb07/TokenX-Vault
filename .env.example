# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
TELEGRAM_HEALTH_CHAT_IDS=
TELEGRAM_TIMEOUT_MS=20000
TELEGRAM_RETRIES=3
TELEGRAM_COMMANDS_ENABLED=true
TELEGRAM_COMMAND_POLL_INTERVAL_MS=5000

# Wallets. Format: Label=0xAddress,Label=0xAddress
WATCHED_WALLETS=TokenX main wallet=0xe6C1ae22207DCe5C5fE66BEC7A314aa0B55C3e51,TokenX admin wallet=0x1dA18CeEDf24dEb656FB85ee40f49c3f698b13c0

# Monitoring
USE_WEBSOCKET=true
START_FROM_LATEST_ON_BOOT=true
POLL_INTERVAL_MS=10000
CONFIRMATIONS=1
MAX_BLOCK_RANGE=5
MAX_BACKLOG_BLOCKS=25
STATE_FILE=/app/data/state.json
RPC_TIMEOUT_MS=20000
RPC_MIN_DELAY_MS=400
MIN_ALERT_AMOUNT=1
ALERT_INCOMING=true
ALERT_OUTGOING=true
ALERT_ON_STARTUP=true
LOG_SCAN_PROGRESS=true
LOG_WEBSOCKET_DECODED_SUMMARY=true
WEBSOCKET_DECODED_SUMMARY_INTERVAL_MS=30000
TELEGRAM_HEALTH_UPDATE_ENABLED=true
TELEGRAM_HEALTH_UPDATE_INTERVAL_MS=3600000

# Balance reports are sent to every ID in TELEGRAM_CHAT_IDS.
BALANCE_REPORT_TIMES=12:00,21:00
BALANCE_REPORT_TIMEZONE=Asia/Karachi

# Ethereum mainnet
ETH_RPC_URLS=https://eth.llamarpc.com,https://ethereum.publicnode.com,https://rpc.ankr.com/eth,https://cloudflare-eth.com,https://eth-mainnet.public.blastapi.io,https://1rpc.io/eth,https://rpc.flashbots.net
